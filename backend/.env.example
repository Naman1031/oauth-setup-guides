# Copy this file to backend/.env and fill in real values. Never commit .env.

# development | production | test
ENVIRONMENT=development

# Supabase → Project → Connect → "Session pooler" connection string (port 5432).
# The session pooler works on IPv4 networks such as Render; the direct
# connection is IPv6-only. Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Comma-separated frontend origins allowed by CORS (no "*").
CORS_ORIGINS=http://localhost:5173

# Local PostgreSQL database used ONLY by the test suite. It is wiped by tests.
# The name must contain "test". Create it with: python -m scripts.create_test_database
TEST_DATABASE_URL=postgresql://postgres:[LOCAL-POSTGRES-PASSWORD]@localhost:5432/oauth_guides_test

# ---- Research agent (OpenAI Responses API + built-in web_search) ----
# API billing is separate from any ChatGPT subscription. Set a hard spend
# limit in the OpenAI dashboard (Project settings → Limits).
# Paste your secret key after the = (it starts with "sk-").
OPENAI_API_KEY=
# Must support Responses API, web_search and Structured Outputs. Verified 2026-11-05: gpt-6-luna.
OPENAI_MODEL=gpt-6-luna
# Optional tuning (defaults shown). These bound the cost of ONE research request.
OPENAI_REASONING_EFFORT=medium
OPENAI_SEARCH_CONTEXT_SIZE=medium
OPENAI_MAX_OUTPUT_TOKENS=20000
OPENAI_MAX_TOOL_CALLS=8
OPENAI_TIMEOUT_SECONDS=300

# ---- Research rate limits (in-memory, per server instance) ----
RESEARCH_REQUESTS_PER_IP_PER_HOUR=5
RESEARCH_REQUESTS_PER_DAY=30
RESEARCH_MAX_CONCURRENT=2
