# Copy this file to backend/.env and fill in real values. Never commit .env.

# development | production | test
ENVIRONMENT=development

# Supabase → Project → Connect → "Session pooler" connection string (port 5432).
# The session pooler works on IPv4 networks such as Render; the direct
# connection is IPv6-only. Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Comma-separated frontend origins allowed by CORS (no "*").
CORS_ORIGINS=http://localhost:5173

# Local PostgreSQL database used ONLY by the test suite. It is wiped by tests.
# The name must contain "test". Create it with: python -m scripts.create_test_database
TEST_DATABASE_URL=postgresql://postgres:[LOCAL-POSTGRES-PASSWORD]@localhost:5432/oauth_guides_test
